# 本项目的 API Key 默认保存在系统凭据管理器中（首次运行时按向导配置），无需在此填写。
#
# 如果你偏好用文件管理 Key，取消下面的注释并填写即可（.env 明文存储，
# 已被 .gitignore 排除、不会提交，但安全性弱于系统凭据管理器）。
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=qwen-turbo

# 交叉验证是否开启思考模式：判定更准但该环节耗时从约10秒增至3~4分钟（默认 false）
# VERIFY_ENABLE_THINKING=true

# 候选圈定/交通估算是否启用 LLM 服务商的联网搜索能力（默认 false）：
# 部分服务商的联网搜索插件属独立计费（不在资源包抵扣范围内），开启前请确认计费方式。
# 近期热度已由抖音采集提供、交通已由高德提供；服务商不支持联网参数时也会自动降级。
# LLM_WEB_SEARCH=true

# 抖音 UGC 数据源开关（开源合规，默认关闭）：
# 默认 false = 不发起任何抖音采集，行程/攻略走"缓存 + LLM 基线"（kernel-only）；本地已采缓存仍可读。
# 设为 true 即启用抖音适配器；启用前请阅读 README「合规声明」：仅个人/研究用途、遵守平台 ToS、
# 使用采集专用小号、使用者自担责任；频控为合规底线请勿调低。
# SOURCE_DOUYIN_ENABLED=true

# 采集侧安全阀（一般不用改）：
# 会话级详情页导航预算（默认 6，贴住抖音"连续 5~6 次视频页导航"的风控红线）。
# 一次任务里的攻略层/候选验证/逐点调研/餐厅调研**共享同一预算**，用尽即主动停手，
# 稍后重新生成即可补齐（已采点位命中 7 天缓存）。调大只会更容易撞验证码、加重账号风控。
# SESSION_DETAIL_BUDGET=6

# 口播转写（本地 faster-whisper）：开启后每条视频增加约30~90秒，转写文本入知识库可复用
# ASR_ENABLED=true
# ASR_MODEL_SIZE=small

# 高德地图 Web服务 API Key（行程规划师用，可选）：
# 高德开放平台 -> 控制台 -> 应用管理 -> 创建"Web服务"类型 Key；个人开发者每日 5000 次免费。
# 不填则行程规划降级为纯 LLM 按区域排线（顺路精度弱）。
# AMAP_API_KEY=你的高德Web服务Key（32位；控制台创建"Web服务"类型后复制，勿把真key提交进仓库）
# 高德日用量安全上限（默认 300，个人开发者免费配额为 5000 次/日）
# AMAP_DAILY_CAP=300
# 准备好资料后的规划子图：恢复不重新采集；预算是planning范围实际模型HTTP尝试。
PLANNING_GRAPH_ENABLED=true
PLANNING_POLICY=hard-first-v1
PLANNING_MAX_HTTP_ATTEMPTS=12
PLANNING_SNAPSHOT_TTL=86400

# —— 服务化升级（2026-10）：持久任务 / 身份 / Worker / 缓存 ——
# 默认本地 SQLite 模式；服务模式改为 mysql（需 pip install -r requirements-service.txt 并配置 DSN）。
STORAGE_BACKEND=sqlite
# MYSQL_DSN=mysql+pymysql://user:pass@127.0.0.1:3306/travelguide?charset=utf8mb4
# 任务/报告账本路径（默认 data/tasks.db、data/reports.db；演示/测试可改到独立目录）
# TASK_DB_PATH=data/tasks.db
# REPORT_DB_PATH=data/reports.db
# KNOWLEDGE_DB_PATH=data/knowledge.db
# REPORT_DIR=data/reports

# 身份：local_single_user（本地演示）/ api_token（服务端令牌）
# AUTH_MODE=api_token
# 创建令牌：python scripts/manage_principal.py create --owner alice
# MCP 远端/令牌模式：TG_API_TOKEN=...

# Worker：默认嵌入 API 进程；服务模式建议 WORKER_EMBEDDED=false 并单独启动
#   python -m service.worker --role pipeline
#   python -m service.worker --role query
WORKER_ENABLED=true
WORKER_EMBEDDED=true
WORKER_ROLE=both
PIPELINE_WORKER_CAPACITY=1
QUERY_WORKER_CAPACITY=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=90
WORKER_MAX_ATTEMPTS=2
MAX_QUEUE_TOTAL=200
MAX_ACTIVE_PER_OWNER=2
CHECKPOINT_REALM=local-planning

# Redis 可丢弃缓存/限流（默认关闭；断开时自动降级，不影响任务账本）
CACHE_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0

# 工具 Agent 起始预算（待效果测试调整，不是性能结果）
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_ROUTE_CALLS=2
AGENT_MAX_CHAT_ATTEMPTS=6
AGENT_MAX_EMBED_ATTEMPTS=2
AGENT_DEADLINE_SECONDS=90
GLOBAL_MODEL_INFLIGHT=2
